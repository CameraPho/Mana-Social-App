// app/api/parse-file/route.ts
// Legacy compatibility route - redirects to smart-parse
import { NextRequest, NextResponse } from 'next/server'

export async function POST(req: NextRequest) {
  try {
    const body = await req.json()
    const url = new URL(req.url)
    const smartUrl = `${url.origin}/api/smart-parse`

    const res = await fetch(smartUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })

    const data = await res.json()

    // Backward compatibility shape
    if (data.items) {
      return NextResponse.json({ result: data.items })
    }

    return NextResponse.json(data)
  } catch (err: any) {
    return NextResponse.json({ error: err.message }, { status: 500 })
  }
}
